<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_multi_supplierinfo_form" model="ir.ui.view">
        <field name="name">multi.supplierinfo.form</field>
        <field name="model">multi.supplierinfo</field>
        <field name="arch" type="xml">
            <form string="Multi Vendor Pricelist">
                <sheet>
                    <group>
                        <group string="VENDOR">
                            <field name="partner_ids" widget="many2many_tags"/>
                        </group>
                        <group string="PRICELIST">
                            <field name="product_tmpl_ids" widget="many2many_tags"/>
                            <field name="price"/>
                            <field name="discount" readonly="discount_amount != 0"/>
                            <field name="discount_amount" readonly="discount != 0"/>
                            <field name="min_qty"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_multi_supplierinfo_tree" model="ir.ui.view">
        <field name="name">multi.supplierinfo.tree</field>
        <field name="model">multi.supplierinfo</field>
        <field name="arch" type="xml">
            <list string="Multi Vendor Pricelist">
                <field name="partner_ids" widget="many2many_tags"/>
                <field name="product_tmpl_ids" widget="many2many_tags"/>
                <field name="price"/>
                <field name="discount"/>
                <field name="discount_amount"/>
                <field name="min_qty"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="action_multi_supplierinfo" model="ir.actions.act_window">
        <field name="name">Multi Vendor Pricelists</field>
        <field name="res_model">multi.supplierinfo</field>
        <field name="view_mode">list,form</field>
    </record>

