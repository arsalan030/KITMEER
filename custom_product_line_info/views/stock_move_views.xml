<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_custom" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.custom</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- 1. Product_id ke context aur options update karein taake Internal Ref aur Description product cell me na aaye -->
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_id']" position="attributes">
                <attribute name="context">{'display_default_code': False}</attribute>
                <attribute name="options">{'display_description': False}</attribute>
            </xpath>

            <!-- 2. Description_picking column ko sirf Receipt (incoming) par hide karein, taake product cell me merge na ho -->
            <xpath expr="//field[@name='move_ids']/list/field[@name='description_picking']" position="attributes">
                <attribute name="column_invisible">parent.picking_type_code == 'incoming'</attribute>
            </xpath>

            <!-- 3. Product_id ke baad custom fields add karein (Internal Ref aur Description alag columns me) -->
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_id']" position="after">
                <field name="product_default_code" optional="show"/>
                <field name="product_description" optional="show"/>
            </xpath>

            <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom_qty']" position="after">
                <field name="location_id" optional="show" domain="[]" options="{'no_create': True, 'no_open': True}"/>
                <field name="unit_quantity" optional="show" readonly="1" column_invisible="parent.picking_type_code in ('incoming', 'outgoing')"/>
                <field name="product_amount" optional="show" readonly="1" column_invisible="parent.picking_type_code != 'incoming'"/>
            </xpath>

        </field>
    </record>
</odoo>